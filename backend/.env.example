PORT=4001
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here

# Environment ('development' or 'production')
NODE_ENV=development

# Development Database Configuration (MySQL Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=Hulu-market
DB_PASSWORD=Hulu-market
DB_NAME=Hulu_market

# Production Database Configuration (Managed MySQL / Aiven / RDS / Cloud SQL)
# When NODE_ENV=production, configure DATABASE_URL or PRODUCTION_DATABASE_URL with your managed DB URI
PRODUCTION_DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<dbname>?ssl-mode=REQUIRED
DATABASE_URL=
